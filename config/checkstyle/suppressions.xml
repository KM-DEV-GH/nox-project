<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!--
      ArchUnit derives the displayed test name from the @ArchTest field name, so these
      static final fields are deliberately camelCase rather than CONSTANT_CASE.
    -->
    <suppress files="[\\/]architecture[\\/]" checks="ConstantName"/>
</suppressions>
