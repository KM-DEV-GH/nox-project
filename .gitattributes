# Normalize line endings in the repository itself, so correctness does not depend
# on each contributor's editor honouring .editorconfig.

# Detect text files automatically and store them with LF in the repository.
* text=auto eol=lf

# Explicit text types.
*.java      text eol=lf diff=java
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.properties text eol=lf
*.md        text eol=lf diff=markdown
*.sql       text eol=lf
*.sh        text eol=lf
*.http      text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.editorconfig text eol=lf

# The Maven wrapper scripts are executed by their platform's shell.
mvnw        text eol=lf
mvnw.cmd    text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary files: never convert, never diff as text.
*.jar       binary
*.war       binary
*.class     binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.p12       binary
*.jks       binary
