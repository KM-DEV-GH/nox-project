# EditorConfig: IDE-agnostic formatting baseline.
# Natively supported by IntelliJ IDEA, Eclipse, VS Code, NetBeans, Vim, Zed and others.
# Java-specific rules (wrapping, import order, braces) live in Spotless/Palantir in pom.xml.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,xsd,xsl}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{js,mjs,ts,css,scss,html}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.properties]
indent_size = 2

[*.http]
indent_size = 2

[*.sql]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Windows batch files require CRLF to execute correctly.
[*.{cmd,bat}]
end_of_line = crlf

# Vendored Maven wrapper: leave exactly as shipped upstream.
[.mvn/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
